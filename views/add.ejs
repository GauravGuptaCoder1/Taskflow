<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Task</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>
    <%- include("navbar.ejs") %>
    <h2>Enter the Details of new Task</h2>
    <form method="post" action="/tasks/<%=newId%>">
        <label for="title">Title : </label>
        <input type="text" placeholder="Enter title" name="title" id="title"><br><br>
        <label for="description">Description : </label>
        <textarea placeholder="Enter Description" name="description" id="description"></textarea><br><br>
        <label for="status">Status:</label>
        <select name="status" id="status">
            <option value="Pending">Pending</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
        </select>   
        <label for="priority">Priority:</label>
        <select name="priority" id="priority">
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Low">Low</option>
        </select>  
        <button>
            <i class="fa-solid fa-plus"></i>
            Add Task
        </button>
    </form>
</body>
</html>