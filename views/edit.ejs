<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body>
    <%- include("navbar.ejs") %>
    <h2>Edit Task Section</h2>
    <form method="POST" action="/tasks/<%=task.id%>?_method=PATCH">
        <label for="title">Title : </label>
        <input type="text" value="<%=task.title%>" name="title" id="title"><br><br>
        <label for="description">Description : </label>
        <textarea placeholder="Enter Description" name="description"
            id="description"><%=task.description%></textarea><br><br>
        <label for="status">Status:</label>
        <select name="status" id="status">
            <option value="Pending" <%=task.status==="Pending" ? "selected" : "" %>>
                Pending
            </option>
            <option value="In Progress" <%=task.status==="In Progress" ? "selected" : "" %>>
                In Progress
            </option>
            <option value="Completed" <%=task.status==="Completed" ? "selected" : "" %>>
                Completed
            </option>
        </select>
        <select name="priority" id="priority">
            <option value="Medium" <%=task.status==="Medium" ? "selected" : "" %>>
                Medium
            </option>
            <option value="High" <%=task.status==="High" ? "selected" : "" %>>
                High
            </option>
            <option value="Low" <%=task.status==="Low" ? "selected" : "" %>>
                Low
            </option>
        </select>
        <br><br>
        <button>
            <i class="fa-solid fa-pen-to-square"></i>&nbsp;
            Edit Task
        </button>
    </form>
</body>

</html>